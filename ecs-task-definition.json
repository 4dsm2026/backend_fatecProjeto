{
  "family": "backend-service",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::role/ecsTaskRole",
  "containerDefinitions": [
    {
      "name": "backend",
      "image": "<AWS_ACCOUNT_ID>.dkr.ecr.sa-east-1.amazonaws.com/workflow-fatec-backend:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 3333,
          "protocol": "tcp"
        }
      ],
      "healthCheck": {
        "command": ["CMD-SHELL", "wget -qO- http://localhost:3333/health || exit 1"],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 15
      },
      "environment": [
        { "name": "NODE_ENV", "value": "production" },
        { "name": "PORT", "value": "3333" },
        { "name": "MAIL_DRIVER", "value": "ses" },
        { "name": "AWS_SES_REGION", "value": "sa-east-1" },
        { "name": "STORAGE_DRIVER", "value": "s3" },
        { "name": "S3_REGION", "value": "sa-east-1" }
      ],
      "secrets": [
        { "name": "DATABASE_URL", "valueFrom": "arn:aws:ssm:sa-east-1:<ACCOUNT_ID>:parameter/workflow/DATABASE_URL" },
        { "name": "JWT_ACCESS_SECRET", "valueFrom": "arn:aws:ssm:sa-east-1:<ACCOUNT_ID>:parameter/workflow/JWT_ACCESS_SECRET" },
        { "name": "JWT_REFRESH_SECRET", "valueFrom": "arn:aws:ssm:sa-east-1:<ACCOUNT_ID>:parameter/workflow/JWT_REFRESH_SECRET" },
        { "name": "COOKIE_SECRET", "valueFrom": "arn:aws:ssm:sa-east-1:<ACCOUNT_ID>:parameter/workflow/COOKIE_SECRET" },
        { "name": "CORS_ORIGIN", "valueFrom": "arn:aws:ssm:sa-east-1:<ACCOUNT_ID>:parameter/workflow/CORS_ORIGIN" },
        { "name": "APP_WEB_URL", "valueFrom": "arn:aws:ssm:sa-east-1:<ACCOUNT_ID>:parameter/workflow/APP_WEB_URL" },
        { "name": "MAIL_FROM", "valueFrom": "arn:aws:ssm:sa-east-1:<ACCOUNT_ID>:parameter/workflow/MAIL_FROM" },
        { "name": "S3_BUCKET", "valueFrom": "arn:aws:ssm:sa-east-1:<ACCOUNT_ID>:parameter/workflow/S3_BUCKET" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/workflow-fatec-backend",
          "awslogs-region": "sa-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
