# App

NODE_ENV=development
PORT=3333
CORS_ORIGIN=[http://localhost:5173](http://localhost:5173)

# Banco de dados (MySQL)

DATABASE_URL="mysql://root:root@localhost:3306/workflow_fatec"

# Autenticação

JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Email (Resend)

RESEND_API_KEY=re_...
RESEND_FROM=Suporte [suporte@workflowfatec.com.br](mailto:suporte@workflowfatec.com.br)

# Storage

STORAGE_DRIVER=local # local|s3
LOCAL_STORAGE_DIR=./uploads
S3_BUCKET=workflow-evidence
S3_REGION=sa-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
