# App
NODE_ENV=development
PORT=3333
CORS_ORIGIN=http://localhost:3000
APP_WEB_URL=http://localhost:3000

# Banco de dados (MySQL)
DATABASE_URL="mysql://root:root@localhost:3306/workflow_fatec"

# Autenticação
JWT_ACCESS_SECRET=secret-local-access
JWT_REFRESH_SECRET=change-me-too
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
JWT_ISSUER=helpdesk
JWT_AUDIENCE=helpdesk-app

# Cookie
COOKIE_SECRET=change-me-cookie-secret

# Email (MAIL_DRIVER: ses | resend)
MAIL_DRIVER=resend
MAIL_FROM=Suporte <no-reply@workflowfatec.com.br>

# Resend (quando MAIL_DRIVER=resend)
RESEND_API_KEY=re_...

# AWS SES (quando MAIL_DRIVER=ses)
AWS_SES_REGION=sa-east-1
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=

# Storage
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./uploads
S3_BUCKET=workflow-evidence
S3_REGION=sa-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
