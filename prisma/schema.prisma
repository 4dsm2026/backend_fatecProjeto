generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}


/**
 * ---------- ENUMS ----------
 */
enum Papel {
  USUARIO
  BACKOFFICE
  TECNICO
  ADMINISTRADOR
}

enum NivelChamado {
  N1
  N2
  N3
}

enum StatusChamado {
  ABERTO
  EM_ATENDIMENTO
  AGUARDANDO_USUARIO
  RESOLVIDO
  ENCERRADO
}

/// Para que o token foi emitido. Um token só vale no fluxo para o qual foi criado.
enum FinalidadeToken {
  RESET_SENHA
  PRIMEIRO_ACESSO
}

enum StatusSugestao {
  NAO_RESPONDIDO
  RESPONDIDO
}

/// Passe Escolar (EMTU/ARTESP) — etapas do pedido entre aluno, Fatec e EMTU.
enum StatusPasseEscolar {
  SOLICITADO // aluno pediu à Fatec o cadastro no portal da EMTU
  PENDENTE_ALUNO // a Fatec pediu correção ou dado faltante
  CADASTRADO_PORTAL // a Fatec cadastrou o aluno no Portal de Relacionamento (ARTESP/EMTU)
  REQUISITADO_EMTU // o aluno preencheu o formulário da EMTU e pagou o boleto
  CONCLUIDO // benefício aprovado pela EMTU
  INDEFERIDO // recusado pela Fatec (não elegível) ou pela EMTU
  CANCELADO // desistência do aluno ou exclusão do portal
}

enum ModalidadePasseEscolar {
  PASSE_LIVRE // isenção total (renda per capita até 1,5 salário mínimo)
  MEIA_TARIFA // 50% de desconto
}

enum TipoPedidoPasseEscolar {
  NOVO
  REVALIDACAO
}

enum PrioridadeChamado {
  BAIXA
  MEDIA
  ALTA
  URGENTE
}

/**
 * ---------- ORGANIZAÇÃO / SETORES / CATÁLOGO ----------
 */
model Organizacao {
  id       String   @id @default(cuid())
  nome     String
  sigla    String?
  criadoEm DateTime @default(now())

  usuarios     Usuario[]
  setores      Setor[]
  categorias   Categoria[]
  chamados     Chamado[]
  notificacoes Notificacao[] @relation("NotificacoesDaOrganizacao")

  @@map("organizacoes")
}

model Setor {
  id            String       @id @default(cuid())
  organizacaoId String?
  nome          String
  descricao     String?
  organizacao   Organizacao? @relation(fields: [organizacaoId], references: [id])

  usuarioSetores UsuarioSetor[]
  chamados       Chamado[]

  @@index([organizacaoId])
  @@map("setores")
}

model PapelCatalogo {
  id        String  @id @default(cuid())
  nome      String  @unique
  descricao String?

  usuarioSetores UsuarioSetor[]

  @@map("papeis")
}

model UsuarioSetor {
  id        String   @id @default(cuid())
  usuarioId String
  setorId   String
  papelId   String?
  criadoEm  DateTime @default(now())

  usuario Usuario        @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  setor   Setor          @relation(fields: [setorId], references: [id], onDelete: Cascade)
  papel   PapelCatalogo? @relation(fields: [papelId], references: [id])

  @@unique([usuarioId, setorId, papelId])
  @@index([setorId])
  @@map("usuarios_setores")
}

model Categoria {
  id            String       @id @default(cuid())
  organizacaoId String?
  nome          String
  descricao     String?
  organizacao   Organizacao? @relation(fields: [organizacaoId], references: [id])

  servicos Servico[]

  @@index([organizacaoId])
  @@map("categorias")
}

model Servico {
  id          String     @id @default(cuid())
  categoriaId String?
  nome        String
  descricao   String?
  ativo       Boolean    @default(true)
  categoria   Categoria? @relation(fields: [categoriaId], references: [id])

  chamados Chamado[]

  @@index([categoriaId])
  @@map("servicos")
}

/**
 * ---------- USUÁRIOS & SESSÕES ----------
 */
model Usuario {
  id                String    @id @default(cuid())
  organizacaoId     String?
  cursoNome         String?
  cursoSigla        String?   @db.VarChar(16)
  nome              String
  emailPessoal      String    @unique
  emailEducacional  String?
  ra                String?   @unique @db.VarChar(32)
  senhaHash         String
  papel             Papel     @default(USUARIO)
  ativo             Boolean   @default(true)
  anonimizado       Boolean   @default(false)
  precisaTrocarSenha Boolean  @default(false)
  criadoEm          DateTime  @default(now())
  atualizadoEm      DateTime  @updatedAt
  deletadoEm        DateTime?
  loginAttempts     Int       @default(0)
  lockedUntil       DateTime?
  lastFailedAttempt DateTime?
  passwordUpdatedAt DateTime?

  unidadeFatec            String?
  curso                   String?
  eixoTecnologico         String?
  turno                   String?
  turma                   String?
  semestreAtual           String?
  matrizCurricular        String?
  situacaoAcademica       String?
  anoSemestreIngresso     String?
  coordenadorCurso        String?

  telefoneCelular               String?  @db.VarChar(20)
  whatsapp                      String?  @db.VarChar(20)
  canalPreferencialContato      String?
  melhorPeriodoContato          String?
  necessitaAtendimentoAcessivel Boolean  @default(false)
  tipoAcessibilidade            String?
  observacoesAtendimento        String?  @db.Text

  // Preferência do usuário: receber notificações in-app (badge + lista).
  notificacoesInApp             Boolean  @default(true)

  organizacao Organizacao? @relation(fields: [organizacaoId], references: [id])

  chamadosCriados    Chamado[]                @relation("ChamadosCriados")
  chamadosAtribuidos Chamado[]                @relation("ChamadosAtribuidos")
  anexos             Anexo[]
  auditorias         Auditoria[]
  mensagens          Mensagem[]
  mudancasStatus     HistoricoStatusChamado[] @relation("StatusPorUsuario")
  sessoes            Sessao[]
  tokensReset        TokenResetSenha[]        @relation("TokensDeUsuario")
  usuarioSetores     UsuarioSetor[]
  loginTentativas    LoginTentativa[]         @relation("LoginTentativasDoUsuario")
  notificacoes       Notificacao[]            @relation("NotificacoesDoUsuario")
  sugestoes          Sugestao[]
  sugestoesRespondidas Sugestao[]             @relation("SugestoesRespondidas")
  passesEscolares      PasseEscolar[]           @relation("PassesDoAluno")
  passesCadastrados    PasseEscolar[]           @relation("PassesCadastradosPor")
  passesHistorico      PasseEscolarHistorico[]  @relation("HistoricoPassePorUsuario")
  pesquisasCriadas     Pesquisa[]               @relation("PesquisasCriadasPor")
  pesquisaParticipacoes PesquisaParticipacao[]

  @@index([emailPessoal])
  @@index([organizacaoId])
  @@index([cursoSigla])
  @@map("usuarios")
}

model Sessao {
  id          String   @id @default(cuid())
  usuarioId   String
  refreshHash String   @unique @db.VarChar(255)
  userAgent   String?
  ip          String?  @db.VarChar(64)
  expiraEm    DateTime
  criadoEm    DateTime @default(now())

  ultimoUsoEm      DateTime  @default(now())
  revogadaEm       DateTime?
  substituidaPorId String?
  substituidaPor   Sessao?   @relation("SessaoSubstituta", fields: [substituidaPorId], references: [id])
  substitui        Sessao[]  @relation("SessaoSubstituta")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@index([expiraEm])
  @@index([revogadaEm])
  @@map("sessoes")
}

model TokenResetSenha {
  id         String          @id @default(cuid())
  usuarioId  String
  tokenHash  String          @unique
  finalidade FinalidadeToken
  expiraEm   DateTime
  usadoEm    DateTime?
  criadoEm   DateTime        @default(now())
  usuario    Usuario         @relation("TokensDeUsuario", fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@index([expiraEm])
  @@map("tokens_reset_senha")
}

model Cliente {
  id           String    @id @default(cuid())
  nome         String
  cpf          String?   @unique @db.VarChar(14)
  email        String?
  telefone     String?   @db.VarChar(20)
  idExterno    String?
  criadoEm     DateTime  @default(now())
  atualizadoEm DateTime  @updatedAt
  deletadoEm   DateTime?

  contratos Contrato[]
  chamados  Chamado[]

  @@index([nome])
  @@index([cpf])
  @@map("clientes")
}

model Contrato {
  id           String    @id @default(cuid())
  clienteId    String
  numero       String    @db.VarChar(64)
  plano        String?
  dataInicio   DateTime?
  dataFim      DateTime?
  ativo        Boolean   @default(true)
  criadoEm     DateTime  @default(now())
  atualizadoEm DateTime  @updatedAt
  deletadoEm   DateTime?
  cliente      Cliente   @relation(fields: [clienteId], references: [id])

  chamados Chamado[] @relation("ChamadosDoContrato")

  @@unique([clienteId, numero])
  @@index([clienteId])
  @@map("contratos")
}

/**
 * ---------- CHAMADOS ----------
 */
model Chamado {
  id            String            @id @default(cuid())
  organizacaoId String?
  protocolo     String?           @unique
  titulo        String
  descricao     String            @db.Text
  nivel         NivelChamado      @default(N1)
  status        StatusChamado     @default(ABERTO)
  prioridade    PrioridadeChamado @default(MEDIA)

  servicoId String?
  setorId   String?

  clienteId  String?
  contratoId String?

  responsavelId String?
  criadoPorId   String

  criadoEm     DateTime  @default(now())
  atualizadoEm DateTime  @updatedAt
  encerradoEm  DateTime?
  deletadoEm   DateTime?
  arquivadoEm  DateTime?

  catalogoServicoId     String?
  catalogoCategoriaId   String?
  catalogoCategoriaNome String?
  setorProvavel         String?
  dadosAcademicos       Json?
  camposEspecificos     Json?
  origem                String?

  precisaAcaoDoAluno Boolean   @default(false)
  observacaoInterna  String?   @db.Text
  slaHoras           Int?
  slaDias            Int?
  vencimentoSla      DateTime?

  organizacao Organizacao? @relation(fields: [organizacaoId], references: [id])
  servico     Servico?     @relation(fields: [servicoId], references: [id])
  setor       Setor?       @relation(fields: [setorId], references: [id])
  cliente     Cliente?     @relation(fields: [clienteId], references: [id])
  contrato    Contrato?    @relation("ChamadosDoContrato", fields: [contratoId], references: [id])
  responsavel Usuario?     @relation("ChamadosAtribuidos", fields: [responsavelId], references: [id])
  criadoPor   Usuario      @relation("ChamadosCriados", fields: [criadoPorId], references: [id])

  anexos       Anexo[]
  historico    HistoricoStatusChamado[]
  mensagens    Mensagem[]
  tags         ChamadoTag[]
  notificacoes Notificacao[]            @relation("NotificacoesDoChamado")

  @@index([status, nivel])
  @@index([criadoEm])
  @@index([clienteId])
  @@index([setorId])
  @@index([servicoId])
  @@index([organizacaoId])
  @@index([catalogoServicoId])
  @@index([origem])
  @@map("chamados")
}

model HistoricoStatusChamado {
  id           String         @id @default(cuid())
  chamadoId    String
  de           StatusChamado?
  para         StatusChamado
  porUsuarioId String?
  observacao   String?
  criadoEm     DateTime       @default(now())
  chamado      Chamado        @relation(fields: [chamadoId], references: [id], onDelete: Cascade)
  porUsuario   Usuario?       @relation("StatusPorUsuario", fields: [porUsuarioId], references: [id])

  @@index([chamadoId])
  @@index([criadoEm])
  @@map("historico_status_chamado")
}

model Mensagem {
  id           String    @id @default(cuid())
  chamadoId    String
  autorId      String
  conteudo     String    @db.Text
  criadoEm     DateTime  @default(now())
  atualizadoEm DateTime  @updatedAt
  deletadoEm   DateTime?
  lidaEm       DateTime?
  chamado      Chamado   @relation(fields: [chamadoId], references: [id], onDelete: Cascade)
  autor        Usuario   @relation(fields: [autorId], references: [id])
  
  notificacoes Notificacao[] @relation("NotificacoesDaMensagem")

  @@index([chamadoId])
  @@map("mensagens")
}

model Anexo {
  id             String  @id @default(cuid())
  chamadoId      String
  nomeArquivo    String
  mimeType       String
  tamanhoBytes   Int
  caminhoArquivo String
  storageBucket  String? @default("anexos")
  checksumSha256 String? @db.VarChar(64)

  enviadoPorId String
  enviadoEm    DateTime @default(now())
  chamado      Chamado  @relation(fields: [chamadoId], references: [id], onDelete: Cascade)
  enviadoPor   Usuario  @relation(fields: [enviadoPorId], references: [id])

  notificacoes Notificacao[] @relation("NotificacoesDoAnexo")

  @@index([chamadoId])
  @@map("anexos")
}

model Tag {
  id       String       @id @default(cuid())
  nome     String       @unique
  cor      String?      @db.VarChar(16)
  criadoEm DateTime     @default(now())
  chamados ChamadoTag[]

  @@map("tags")
}

model ChamadoTag {
  chamadoId String
  tagId     String
  chamado   Chamado @relation(fields: [chamadoId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([chamadoId, tagId])
  @@index([tagId])
  @@map("chamados_tags")
}

model Auditoria {
  id         String    @id @default(cuid())
  feitoPorId String?
  acao       String
  alvo       String?
  meta       Json?
  feitoEm    DateTime  @default(now())

  feitoPor   Usuario?  @relation(fields: [feitoPorId], references: [id])

  @@index([feitoEm])
  @@index([feitoPorId])
  @@index([acao])
  @@map("auditoria")
}

model EmailEnvio {
  id            String    @id @default(cuid())
  destinatario  String
  assunto       String
  payload       Json
  providerMsgId String?
  status        String    @default("pendente")
  erro          String?
  criadoEm      DateTime  @default(now())
  enviadoEm     DateTime?

  @@index([status])
  @@map("email_envios")
}

model LoginTentativa {
  id        String   @id @default(cuid())
  email     String
  usuarioId String?
  sucesso   Boolean
  ip        String?  @db.VarChar(64)
  userAgent String?
  motivo    String?  
  criadoEm  DateTime @default(now())

  usuario Usuario? @relation("LoginTentativasDoUsuario", fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([email, criadoEm])
  @@index([usuarioId, criadoEm])
  @@map("login_tentativas")
}

enum TipoNotificacao {
  CHAMADO_CRIADO
  CHAMADO_ATRIBUIDO
  CHAMADO_ATUALIZADO
  STATUS_ALTERADO
  MENSAGEM_NOVA
  ANEXO_NOVO
  SISTEMA
}

enum CanalNotificacao {
  IN_APP
  EMAIL
  PUSH
}

model Notificacao {
  id        String           @id @default(cuid())
  usuarioId String
  titulo    String
  mensagem  String           @db.Text
  tipo      TipoNotificacao
  canal     CanalNotificacao @default(IN_APP)

  organizacaoId String?
  chamadoId     String?
  mensagemId    String?
  anexoId       String?

  entregueEm  DateTime?
  lidaEm      DateTime?
  arquivadaEm DateTime?
  erroEntrega String?
  meta        Json?
  criadoEm    DateTime  @default(now())

  usuario     Usuario      @relation("NotificacoesDoUsuario", fields: [usuarioId], references: [id], onDelete: Cascade)
  organizacao Organizacao? @relation("NotificacoesDaOrganizacao", fields: [organizacaoId], references: [id])
  chamado     Chamado?     @relation("NotificacoesDoChamado", fields: [chamadoId], references: [id])
  mensagemRef Mensagem?    @relation("NotificacoesDaMensagem", fields: [mensagemId], references: [id])
  anexoRef    Anexo?       @relation("NotificacoesDoAnexo", fields: [anexoId], references: [id])

  @@index([usuarioId, criadoEm])
  @@index([chamadoId])
  @@index([organizacaoId])
  @@index([tipo, canal])
  @@map("notificacoes")
}

/// Templates de e-mail editáveis pelo admin (tela de Comunicações).
model ComunicacaoTemplate {
  id          String   @id @default(cuid())
  chave       String   @unique
  nome        String
  descricao   String?  @db.Text
  habilitado  Boolean  @default(true)
  assunto     String   @db.Text
  corpo       String   @db.Text
  variaveis   Json?
  criadoEm    DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@map("comunicacao_templates")
}

model Sugestao {
  id           String         @id @default(cuid())
  usuarioId    String
  emailContato String
  conteudo     String         @db.Text
  documento    Json?
  status       StatusSugestao @default(NAO_RESPONDIDO)
  resposta     String?        @db.VarChar(1000)
  respostaDocumento Json?
  criadoEm     DateTime       @default(now())

  respondidoPorId String?
  respondidoEm    DateTime?

  usuario      Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  respondidoPor Usuario? @relation("SugestoesRespondidas", fields: [respondidoPorId], references: [id])

  @@index([usuarioId])
  @@index([criadoEm])
  @@index([status])
  @@map("sugestoes")
}

/// Pedido de Passe Escolar (EMTU/ARTESP). Funcionalidade em beta.
/// Guarda os dados que a Fatec precisa lançar no Portal de Relacionamento e
/// o andamento das etapas, para o aluno acompanhar sem perguntar à secretaria.
model PasseEscolar {
  id            String                 @id @default(cuid())
  usuarioId     String
  anoReferencia Int
  tipo          TipoPedidoPasseEscolar @default(NOVO)
  modalidade    ModalidadePasseEscolar
  status        StatusPasseEscolar     @default(SOLICITADO)

  // Dados exigidos pelo portal (a Fatec só pode incluir quem tiver todos).
  nomeCompleto        String  @db.VarChar(120)
  rg                  String  @db.VarChar(20)
  cpf                 String  @db.VarChar(11)
  cep                 String  @db.VarChar(8)
  municipioResidencia String  @db.VarChar(80)
  curso               String  @db.VarChar(120)
  periodo             String  @db.VarChar(40)
  mesConclusao        Int
  anoConclusao        Int
  declaraBaixaRenda   Boolean @default(false)
  observacaoAluno     String? @db.Text

  // Lado da Fatec e da EMTU
  orientacaoFatec    String?   @db.Text // última orientação dada ao aluno (pendência, indeferimento…)
  cadastradoPortalEm DateTime?
  cadastradoPorId    String?
  protocoloEmtu      String?   @db.VarChar(40) // número do formulário/requisição na EMTU, informado pelo aluno
  encerradoEm        DateTime?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  usuario       Usuario  @relation("PassesDoAluno", fields: [usuarioId], references: [id], onDelete: Cascade)
  cadastradoPor Usuario? @relation("PassesCadastradosPor", fields: [cadastradoPorId], references: [id])

  historico PasseEscolarHistorico[]

  @@index([usuarioId, anoReferencia])
  @@index([anoReferencia, status])
  @@index([status])
  @@index([criadoEm])
  @@map("passes_escolares")
}

model PasseEscolarHistorico {
  id         String              @id @default(cuid())
  passeId    String
  de         StatusPasseEscolar?
  para       StatusPasseEscolar
  comentario String?             @db.Text
  autorId    String?
  criadoEm   DateTime            @default(now())

  passe PasseEscolar @relation(fields: [passeId], references: [id], onDelete: Cascade)
  autor Usuario?     @relation("HistoricoPassePorUsuario", fields: [autorId], references: [id])

  @@index([passeId, criadoEm])
  @@map("passes_escolares_historico")
}

/// Pesquisa institucional (CPA). Funcionalidade em beta.
enum StatusPesquisa {
  RASCUNHO  // em montagem: perguntas ainda podem mudar
  ABERTA    // alunos respondem
  ENCERRADA // só resultados
}

enum TipoPerguntaPesquisa {
  ESCALA   // 1 (péssimo) a 5 (ótimo); 0 = não sei / não se aplica
  MULTIPLA // uma opção entre as de `opcoes`
  TEXTO    // resposta aberta
}

/// Uma edição da pesquisa, por semestre (ex.: "2026-2").
model Pesquisa {
  id          String         @id @default(cuid())
  titulo      String         @db.VarChar(160)
  descricao   String?        @db.Text
  semestre    String         @db.VarChar(6)
  status      StatusPesquisa @default(RASCUNHO)
  /// Lista de cursos (cursoNome) que respondem. null = todos os cursos.
  cursos      Json?
  /// Prazo: depois desta data não aceita respostas, mesmo com status ABERTA.
  fechaEm     DateTime?
  abertaEm    DateTime?
  encerradaEm DateTime?
  criadoPorId String?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  criadoPor     Usuario?               @relation("PesquisasCriadasPor", fields: [criadoPorId], references: [id])
  perguntas     PesquisaPergunta[]
  participacoes PesquisaParticipacao[]
  respostas     PesquisaResposta[]

  @@index([semestre])
  @@index([status])
  @@map("pesquisas")
}

model PesquisaPergunta {
  id          String               @id @default(cuid())
  pesquisaId  String
  ordem       Int
  secao       String?              @db.VarChar(80)
  texto       String               @db.VarChar(300)
  tipo        TipoPerguntaPesquisa
  opcoes      Json?
  obrigatoria Boolean              @default(true)

  pesquisa Pesquisa @relation(fields: [pesquisaId], references: [id], onDelete: Cascade)

  @@index([pesquisaId, ordem])
  @@map("pesquisas_perguntas")
}

/// QUEM respondeu (para impedir resposta dupla). Não guarda o que foi respondido.
model PesquisaParticipacao {
  id         String @id @default(cuid())
  pesquisaId String
  usuarioId  String

  pesquisa Pesquisa @relation(fields: [pesquisaId], references: [id], onDelete: Cascade)
  usuario  Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([pesquisaId, usuarioId])
  @@map("pesquisas_participacoes")
}

/// O QUE foi respondido, sem ligação com o aluno: sem usuarioId, sem data/hora,
/// e com id aleatório (uuid v4; cuid embute o horário e permitiria cruzar com a
/// participação). Guarda só curso e turno, para os recortes dos resultados.
model PesquisaResposta {
  id         String  @id @default(uuid())
  pesquisaId String
  curso      String  @db.VarChar(128)
  turno      String? @db.VarChar(40)
  /// { [perguntaId]: número (escala) | texto }
  respostas  Json

  pesquisa Pesquisa @relation(fields: [pesquisaId], references: [id], onDelete: Cascade)

  @@index([pesquisaId, curso])
  @@map("pesquisas_respostas")
}
